RewriteEngine On

# Force non-www
RewriteCond %{HTTP_HOST} ^www\.weareleba\.com$ [NC]
RewriteRule ^(.*)$ https://weareleba.com/$1 [R=301,L]

# Canonical index routes
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^index-en\.html$ /en/ [R=301,L]
RewriteRule ^automate-whatsapp-orders\.html$ /articles/automate-whatsapp-orders [R=301,L]
RewriteRule ^automatizar-pedidos-whatsapp\.html$ /articles/automatizar-pedidos-whatsapp [R=301,L]

# Serve English home at /en/
RewriteRule ^en/?$ /en/index.html [L]

# Serve article routes from root HTML files
RewriteRule ^articles/automate-whatsapp-orders/?$ /automate-whatsapp-orders.html [L]
RewriteRule ^articles/automatizar-pedidos-whatsapp/?$ /automatizar-pedidos-whatsapp.html [L]

# =====================================================================
#  COMPRESSION
# =====================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

# =====================================================================
#  CACHE-CONTROL
#  HTML must revalidate (so deploys are picked up immediately).
#  Hashed/static assets get 1 year immutable.
# =====================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|jpe?g|png|svg|ico|woff2?|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

# =====================================================================
#  SECURITY HEADERS
# =====================================================================
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-site"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self \"https://js.stripe.com\"), interest-cohort=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com https://unpkg.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://assets.calendly.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://*.clarity.ms https://assets.calendly.com https://unpkg.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.clarity.ms https://formspree.io https://calendly.com https://*.calendly.com; frame-src https://calendly.com https://*.calendly.com; object-src 'none'; base-uri 'self'; form-action 'self' https://formspree.io"
</IfModule>

# =====================================================================
#  CONTENT-NEGOTIATION: serve the .webp variant when the browser
#  Accepts it AND a .png/.jpg in the same folder also exists.
# =====================================================================
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{REQUEST_FILENAME} \.(jpe?g|png)$
  RewriteCond %{REQUEST_FILENAME}.webp -f
  RewriteRule ^(.+)\.(jpe?g|png)$ $1.$2.webp [T=image/webp,E=accept:1,L]
</IfModule>
<IfModule mod_headers.c>
  Header append Vary Accept env=REDIRECT_accept
</IfModule>
